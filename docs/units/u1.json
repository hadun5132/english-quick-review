  "grammar": [
    {
      "id": "be-statements",
      "title": "be 動詞的直述與否定",
      "pattern": "主詞 + am / is / are (+ not) + 補語.",
      "tip": "I 搭配 am，單數第三人稱搭配 is，you 和複數主詞搭配 are。not 放在 be 後面。",
      "example": "I am a student. My sister is not a student.",
      "translation": "我是學生。我姊姊不是學生。"
    },
    {
      "id": "be-yes-no",
      "title": "Yes/No 問答",
      "pattern": "Am / Is / Are + 主詞 + 補語?",
      "tip": "把 be 移到主詞前面。肯定簡答用 Yes, she is.，句尾的 she is 要寫完整。",
      "example": "Is Ava a nurse? Yes, she is.",
      "translation": "艾娃是護理師嗎？對，她是。"
    },
    {
      "id": "adjectives",
      "title": "形容詞",
      "pattern": "形容詞 + 名詞；或 主詞 + be + 形容詞.",
      "tip": "形容詞可修飾名詞，也可放在 be 後面。形容詞本身沒有複數變化。",
      "example": "Leo is a young singer. His songs are popular.",
      "translation": "里歐是位年輕的歌手。他的歌很受歡迎。"
    },
    {
      "id": "articles",
      "title": "不定冠詞 a / an",
      "pattern": "a + 子音開頭的發音；an + 母音開頭的發音",
      "tip": "依發音選冠詞，例如 a uniform 和 an hour。單數可數職業名詞通常需要冠詞。",
      "example": "My cousin is an artist.",
      "translation": "我的表親是一位藝術家。"
    },
    {
      "id": "who",
      "title": "Who 問句",
      "pattern": "Who + is / are + 主詞?",
      "tip": "詢問身分時用 Who。主詞是單數時用 is、複數時用 are。",
      "example": "Who is that boy? He is my brother.",
      "translation": "那個男孩是誰？他是我弟弟。"
    }
